{
  "name": "springtail",
  "version": "0.1.0",
  "description": "Follow the log of a Maven / Spring Boot backend live in the browser.",
  "author": "Habakuk Beneke",
  "license": "GPL-3.0-only",
  "keywords": [
    "maven",
    "spring-boot",
    "logs",
    "log-viewer",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hbeneke/springtail.git"
  },
  "homepage": "https://github.com/hbeneke/springtail#readme",
  "bugs": {
    "url": "https://github.com/hbeneke/springtail/issues"
  },
  "type": "module",
  "bin": {
    "springtail": "dist/cli/main.js",
    "stail": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p src && tsc -p src/web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "viewer": "node dist/server/main.js",
    "sync": "node scripts/sync-master.mjs",
    "sync:minor": "node scripts/sync-master.mjs --minor",
    "sync:patch": "node scripts/sync-master.mjs --patch",
    "sync:no-tag": "node scripts/sync-master.mjs --no-tag",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/uninstall-hooks.mjs",
    "prepare": "npm run build && node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
